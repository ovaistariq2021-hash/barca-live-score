{
  "type": "APL",
  "version": "2023.2",
  "theme": "dark",
  "resources": [
    {
      "colors": {
        "barcaBlue": "#0A3B7C",
        "barcaGarnet": "#A50044",
        "barcaGold": "#EDBB00",
        "textPrimary": "#FFFFFF",
        "textMuted": "#C9D6EA"
      }
    }
  ],
  "mainTemplate": {
    "parameters": ["payload"],
    "items": [
      {
        "type": "Container",
        "width": "100%",
        "height": "100%",
        "items": [
          {
            "type": "Frame",
            "width": "100%",
            "height": "100%",
            "background": "linear-gradient(160deg, @barcaBlue 0%, #061F45 55%, @barcaGarnet 100%)",
            "items": [
              {
                "type": "Container",
                "width": "100%",
                "height": "100%",
                "paddingLeft": "5%",
                "paddingRight": "5%",
                "paddingTop": "4%",
                "paddingBottom": "4%",
                "justifyContent": "spaceBetween",
                "items": [
                  {
                    "type": "Container",
                    "direction": "row",
                    "justifyContent": "spaceBetween",
                    "alignItems": "center",
                    "width": "100%",
                    "items": [
                      {
                        "type": "Text",
                        "text": "${payload.scoreboard.competition}",
                        "fontSize": "24dp",
                        "fontWeight": "600",
                        "color": "@textMuted",
                        "letterSpacing": "2dp"
                      },
                      {
                        "type": "Frame",
                        "backgroundColor": "${payload.scoreboard.statusColor}",
                        "borderRadius": "20dp",
                        "paddingLeft": "16dp",
                        "paddingRight": "16dp",
                        "paddingTop": "6dp",
                        "paddingBottom": "6dp",
                        "item": {
                          "type": "Text",
                          "text": "${payload.scoreboard.statusLabel}",
                          "fontSize": "22dp",
                          "fontWeight": "700",
                          "color": "#FFFFFF"
                        }
                      }
                    ]
                  },
                  {
                    "type": "Container",
                    "direction": "row",
                    "alignItems": "center",
                    "justifyContent": "spaceAround",
                    "width": "100%",
                    "items": [
                      {
                        "type": "Container",
                        "alignItems": "center",
                        "width": "35%",
                        "items": [
                          {
                            "type": "Image",
                            "source": "${payload.scoreboard.homeCrest}",
                            "width": "140dp",
                            "height": "140dp",
                            "scale": "best-fit",
                            "align": "center"
                          },
                          {
                            "type": "Text",
                            "text": "${payload.scoreboard.homeName}",
                            "fontSize": "30dp",
                            "fontWeight": "700",
                            "color": "@textPrimary",
                            "textAlign": "center",
                            "paddingTop": "12dp"
                          }
                        ]
                      },
                      {
                        "type": "Container",
                        "alignItems": "center",
                        "width": "30%",
                        "items": [
                          {
                            "type": "Text",
                            "text": "${payload.scoreboard.homeScore} - ${payload.scoreboard.awayScore}",
                            "fontSize": "96dp",
                            "fontWeight": "900",
                            "color": "@barcaGold",
                            "textAlign": "center"
                          },
                          {
                            "type": "Text",
                            "text": "${payload.scoreboard.clock}",
                            "fontSize": "26dp",
                            "fontWeight": "600",
                            "color": "@textMuted",
                            "textAlign": "center",
                            "paddingTop": "8dp"
                          }
                        ]
                      },
                      {
                        "type": "Container",
                        "alignItems": "center",
                        "width": "35%",
                        "items": [
                          {
                            "type": "Image",
                            "source": "${payload.scoreboard.awayCrest}",
                            "width": "140dp",
                            "height": "140dp",
                            "scale": "best-fit",
                            "align": "center"
                          },
                          {
                            "type": "Text",
                            "text": "${payload.scoreboard.awayName}",
                            "fontSize": "30dp",
                            "fontWeight": "700",
                            "color": "@textPrimary",
                            "textAlign": "center",
                            "paddingTop": "12dp"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Text",
                    "text": "${payload.scoreboard.footer}",
                    "fontSize": "22dp",
                    "fontWeight": "500",
                    "color": "@textMuted",
                    "textAlign": "center",
                    "width": "100%"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
